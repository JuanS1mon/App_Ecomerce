# =========================================
# DOCKERFILE SIMPLIFICADO PARA DESARROLLO
# =========================================

# Usar imagen base oficial de Python
FROM python:3.9-slim

# Información de metadata
LABEL maintainer="tu-email@tu-dominio.com"
LABEL version="2.0.0-dev"
LABEL description="Sistema de Gestión de Stock - Desarrollo con SQLite"

# Variables de entorno
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ENVIRONMENT=development
ENV TZ=America/Mexico_City

# Crear usuario no-root para seguridad
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Instalar dependencias básicas del sistema
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        sqlite3 \
        netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Establecer directorio de trabajo
WORKDIR /app

# Crear directorios necesarios
RUN mkdir -p /app/logs /app/static /app/temp

# Copiar archivo de requerimientos primero (para mejor cache de Docker)
COPY requirements.txt /app/

# Instalar dependencias de Python
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copiar código de la aplicación
COPY sql_app/ /app/sql_app/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/
COPY .env* /app/

# Cambiar ownership al usuario no-root
RUN chown -R appuser:appuser /app

# Cambiar a usuario no-root
USER appuser

# Exponer puerto
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Script de entrada simplificado
COPY --chown=appuser:appuser docker-entrypoint-simple.sh /app/
RUN chmod +x /app/docker-entrypoint-simple.sh

# Punto de entrada
ENTRYPOINT ["/app/docker-entrypoint-simple.sh"]

# Comando por defecto
CMD ["uvicorn", "sql_app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
