# =============================
# CONFIGURACIÓN PARA PRODUCCIÓN
# =============================
# Renombra este archivo a .env en producción y actualiza los valores

# === CONFIGURACIÓN DE BASE DE DATOS ===
DB_TYPE=sqlserver
DB_USER=tu_usuario_produccion
DB_PASSWORD=tu_password_super_segura_aqui
DB_HOST=tu_servidor_sql.com
DB_NAME=sql_app_production
DB_DRIVER=ODBC Driver 17 for SQL Server

# Pool de conexiones optimizado para producción
POOL_SIZE=20
MAX_OVERFLOW=30
POOL_TIMEOUT=30
POOL_PRE_PING=True
POOL_RECYCLE=1800

# === CONFIGURACIÓN DE SEGURIDAD ===
# IMPORTANTE: Genera una clave secreta fuerte única
SECRET=tu_clave_super_secreta_de_256_bits_minimo_aqui_cambiar_obligatorio
ALGORITHM=HS256
ACCESS_TOKEN_DURATION=60

# === CONFIGURACIÓN DE LA APLICACIÓN ===
PROJECT_NAME=Sistema de Gestión de Stock
ENVIRONMENT=production

# URLs de producción - CAMBIAR OBLIGATORIO
BASE_URL=https://tu-dominio.com
FRONTEND_URL=https://tu-dominio.com

# CORS - Dominios permitidos (separados por coma)
ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# === CONFIGURACIÓN DEL SERVIDOR ===
PORT=8000
WORKERS=4
LOG_LEVEL=info

# === CONFIGURACIÓN DE CORREO ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
USERNAME_EMAIL=tu-email@tu-dominio.com
PASSWORD_EMAIL=tu_app_password_aqui
MAIL_FROM=noreply@tu-dominio.com
MAIL_FROM_NAME=Sistema de Stock

# === CONFIGURACIÓN DE DIRECTORIO ESTÁTICO ===
STATIC_DIR=sql_app/static
