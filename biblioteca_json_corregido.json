{
  "service_name": "biblioteca_sistema",
  "description": "Sistema básico de gestión de biblioteca con autores y libros",
  "tables": [
    {
      "name": "autores",
      "description": "Tabla de autores",
      "fields": [
        {
          "name": "id",
          "field_type": "integer",
          "primary_key": true,
          "auto_increment": true,
          "nullable": false
        },
        {
          "name": "nombre",
          "field_type": "string",
          "max_length": 100,
          "nullable": false
        },
        {
          "name": "email",
          "field_type": "string",
          "max_length": 150,
          "nullable": true
        }
      ]
    },
    {
      "name": "libros",
      "description": "Tabla de libros",
      "fields": [
        {
          "name": "id",
          "field_type": "integer",
          "primary_key": true,
          "auto_increment": true,
          "nullable": false
        },
        {
          "name": "titulo",
          "field_type": "string",
          "max_length": 200,
          "nullable": false
        },
        {
          "name": "autor_id",
          "field_type": "integer",
          "foreign_key": "autores.id",
          "nullable": false
        }
      ]
    }
  ],
  "relationships": [
    {
      "relationship_type": "one_to_many",
      "from_table": "autores",
      "from_field": "id",
      "to_table": "libros",
      "to_field": "autor_id",
      "relationship_name": "libros_del_autor",
      "back_populates": "autor"
    }
  ]
}