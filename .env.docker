# ==========================================
# VARIABLES DE ENTORNO PARA DOCKER
# ==========================================

# Configuración de Base de Datos
DATABASE_URL=mssql+pyodbc://sa:MyStrongPassword123!@database:1433/StockApp?driver=ODBC+Driver+17+for+SQL+Server&charset=utf8
DB_HOST=database
DB_PORT=1433
DB_NAME=StockApp
DB_USER=sa
DB_PASSWORD=MyStrongPassword123!

# Configuración de Aplicación
ENVIRONMENT=production
SECRET_KEY=your-super-secret-key-change-this-in-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de Logs
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Configuración de CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://yourdomain.com"]

# Configuración de archivos
UPLOAD_DIRECTORY=/app/uploads
MAX_FILE_SIZE=10485760

# Configuración de Email (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Configuración de Redis (si se usa para cache)
REDIS_URL=redis://redis:6379/0

# Timezone
TZ=America/Mexico_City
