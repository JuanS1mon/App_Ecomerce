# ===========================================
# CONFIGURACIÓN DE SEGURIDAD MEJORADA
# ===========================================
# IMPORTANTE: Copie este archivo a .env y configure los valores según su entorno

# Configuración JWT
SECRET="11018517e34d137b782c1f6af9d9e20ebb8ec6425b5b97689e2715b6cb3187c4"
ALGORITHM="HS256"
ACCESS_TOKEN_DURATION=360
REFRESH_TOKEN_DURATION=10080

# Configuración de Seguridad Mejorada
JWT_ISSUER=FastAPI-Security-App
JWT_AUDIENCE=sql-app-users

# Configuración de Rate Limiting Avanzado
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_TIME_WINDOW=60
RATE_LIMIT_BLOCK_DURATION=300
RATE_LIMIT_PROGRESSIVE_DELAY=true
RATE_LIMIT_MAX_DELAY=60

# Configuración de Detección de Amenazas
THREAT_DETECTION_ENABLED=true
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_TIME_WINDOW=3600  # 1 hora
DDoS_PROTECTION_ENABLED=true
DDoS_MAX_REQUESTS_PER_MINUTE=60

# Configuración de Contraseñas
PASSWORD_MIN_LENGTH=3
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HASH_ROUNDS=12

# Configuración de Cookies Seguras
COOKIE_SECURE=false  # Cambiar a true en producción con HTTPS
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true

# Configuración de Base de Datos
DB_TYPE=sqlserver
DB_USER=sa
DB_PASSWORD=Pantone123
DB_HOST=localhost
DB_NAME=Sysne
DB_DRIVER=ODBC Driver 17 for SQL Server

#DB_HOST=200.73.129.52
#DB_NAME=tecnolarUnificado
POOL_SIZE=10
MAX_OVERFLOW=25
POOL_TIMEOUT=5
POOL_PRE_PING=True
POOL_RECYCLE=3600

# Configuración de Correo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USERNAMEmail='fjuansimon@gmail.com'
PASSWORDmail='Juan904068'

# Configuración de WhatsApp (opcional)
WHATSAPP_API_URL=your-whatsapp-api-url
WHATSAPP_API_TOKEN=your-whatsapp-token

# Configuración de la aplicación
PROJECT_NAME="Create:API"
ENVIRONMENT=development
# URL base de la aplicación
BASE_URL="http://localhost:8000"
# Dirección URL del frontend para las redirecciones
FRONTEND_URL="http://localhost:3000"

# Orígenes permitidos para CORS
ORIGINS="*"

# Configuración de Logging de Seguridad
SECURITY_LOG_LEVEL=INFO
SECURITY_LOG_FILE=logs/security.log

# Configuración de Redis (para tokens revocados en producción)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Lista de IPs permitidas (opcional, separadas por comas)
ALLOWED_IPS=

# Lista de User-Agents bloqueados (opcional, separadas por comas)
BLOCKED_USER_AGENTS=
