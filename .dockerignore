# ==========================================
# DOCKERIGNORE - Optimización de Build
# ==========================================

# Archivos de Git
.git
.gitignore

# Entorno virtual Python
env/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Archivos de IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs y archivos temporales
logs/
*.log
*.tmp
temp/
.tmp/

# Base de datos local
*.db
*.sqlite
*.sqlite3

# Archivos de backup
backups/
*.bak

# Archivos de documentación (no necesarios en runtime)
*.md
docs/

# Archivos de configuración local
.env.local
.env.development

# Node modules (si los hay)
node_modules/

# Archivos de testing
tests/
*_test.py
test_*.py

# Archivos de monitoreo
monitoring/

# Archivos Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Archivos de CI/CD
.github/
.gitlab-ci.yml

# Archivos de sistema
.DS_Store
Thumbs.db
