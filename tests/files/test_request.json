{
  "service_name": "biblioteca_test",
  "description": "Sistema de biblioteca para pruebas", 
  "tables": [
    {
      "name": "autores",
      "fields": [
        {"name": "id", "field_type": "Integer", "primary_key": true, "autoincrement": true},
        {"name": "nombre", "field_type": "String", "length": 100, "nullable": false},
        {"name": "nacionalidad", "field_type": "String", "length": 50}
      ]
    },
    {
      "name": "libros", 
      "fields": [
        {"name": "id", "field_type": "Integer", "primary_key": true, "autoincrement": true},
        {"name": "titulo", "field_type": "String", "length": 200, "nullable": false},
        {"name": "autor_id", "field_type": "Integer", "nullable": false},
        {"name": "isbn", "field_type": "String", "length": 20}
      ]
    }
  ],
  "relationships": [
    {
      "table1": "autores",
      "table2": "libros",
      "field1": "id", 
      "field2": "autor_id",
      "type": "one_to_many"
    }
  ]
}