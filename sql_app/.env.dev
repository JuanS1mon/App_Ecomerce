# Configuración para desarrollo con Docker y SQLite
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./sql_app.db

# Variables de autenticación
SECRET_KEY=dev-secret-key-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de la aplicación
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Variables opcionales para compatibilidad
APP_NAME="Sistema de Movimientos de Stock"
VERSION="1.0.0"
DESCRIPTION="API para gestión de stocks, instituciones y usuarios"

# Configuraciones adicionales
CORS_ORIGINS=*
LOG_LEVEL=INFO
