# ============================================================================
# PHASE2_TEMPLATES.PY - TEMPLATES PREDEFINIDOS PARA FASE 2
# ============================================================================
"""
Templates predefinidos para casos de uso comunes en sistemas multi-tabla
Estos templates facilitan la creación rápida de sistemas complejos
"""

from typing import Dict, List, Any
from sql_app.routers.config.generator_config import (
    MultiTableServiceConfig, TableConfig, FieldConfig, RelationshipConfig
)

class Phase2Templates:
    """Templates predefinidos para sistemas multi-tabla complejos"""
    
    @staticmethod
    def ecommerce_system() -> Dict[str, Any]:
        """
        Sistema de e-commerce completo con relaciones many-to-many
        """
        return {
            "service_name": "ecommerce_system",
            "description": "Sistema completo de e-commerce con gestión de productos, pedidos y usuarios",
            "version": "2.0.0",
            "generate_many_to_many": True,
            "generate_complex_queries": True,
            "generate_aggregation_endpoints": True,
            "tables": [
                {
                    "name": "usuarios",
                    "description": "Gestión de usuarios del sistema",
                    "category": "usuarios",
                    "enable_soft_delete": True,
                    "enable_audit_trail": True,
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "email", "field_type": "email", "unique": True, "nullable": False},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "apellido", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "telefono", "field_type": "phone", "max_length": 20},
                        {"name": "fecha_registro", "field_type": "datetime", "default_value": "now()"},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"},
                        {"name": "tipo_usuario", "field_type": "enum", "enum_values": ["cliente", "admin", "vendedor"]}
                    ]
                },
                {
                    "name": "categorias",
                    "description": "Categorías de productos",
                    "category": "productos",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "descripcion", "field_type": "text"},
                        {"name": "imagen_url", "field_type": "url"},
                        {"name": "activa", "field_type": "boolean", "default_value": "true"},
                        {"name": "orden", "field_type": "integer", "default_value": "0"}
                    ]
                },
                {
                    "name": "productos",
                    "description": "Catálogo de productos",
                    "category": "productos",
                    "enable_versioning": True,
                    "is_searchable": True,
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 200, "nullable": False, "is_searchable": True},
                        {"name": "descripcion", "field_type": "text", "is_searchable": True},
                        {"name": "precio", "field_type": "decimal", "precision": 10, "scale": 2, "nullable": False},
                        {"name": "precio_oferta", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "sku", "field_type": "string", "max_length": 50, "unique": True},
                        {"name": "stock", "field_type": "integer", "default_value": "0"},
                        {"name": "categoria_id", "field_type": "integer", "foreign_key": "categorias.id"},
                        {"name": "imagen_principal", "field_type": "url"},
                        {"name": "peso", "field_type": "decimal", "precision": 8, "scale": 3},
                        {"name": "dimensiones", "field_type": "string", "max_length": 100},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"},
                        {"name": "fecha_creacion", "field_type": "datetime", "default_value": "now()"}
                    ]
                },
                {
                    "name": "etiquetas",
                    "description": "Etiquetas para productos",
                    "category": "productos",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 50, "unique": True, "nullable": False},
                        {"name": "color", "field_type": "string", "max_length": 7, "default_value": "#000000"},
                        {"name": "activa", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "pedidos",
                    "description": "Pedidos de clientes",
                    "category": "ventas",
                    "enable_audit_trail": True,
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "numero_pedido", "field_type": "string", "max_length": 20, "unique": True},
                        {"name": "usuario_id", "field_type": "integer", "foreign_key": "usuarios.id", "nullable": False},
                        {"name": "fecha_pedido", "field_type": "datetime", "default_value": "now()"},
                        {"name": "estado", "field_type": "enum", "enum_values": ["pendiente", "procesando", "enviado", "entregado", "cancelado"]},
                        {"name": "subtotal", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "impuestos", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "total", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "direccion_envio", "field_type": "text"},
                        {"name": "metodo_pago", "field_type": "enum", "enum_values": ["tarjeta", "paypal", "transferencia", "efectivo"]},
                        {"name": "notas", "field_type": "text"}
                    ]
                },
                {
                    "name": "detalle_pedidos",
                    "description": "Detalle de productos en pedidos",
                    "category": "ventas",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "pedido_id", "field_type": "integer", "foreign_key": "pedidos.id", "nullable": False},
                        {"name": "producto_id", "field_type": "integer", "foreign_key": "productos.id", "nullable": False},
                        {"name": "cantidad", "field_type": "integer", "nullable": False},
                        {"name": "precio_unitario", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "subtotal", "field_type": "decimal", "precision": 10, "scale": 2}
                    ]
                }
            ],
            "relationships": [
                # Relaciones one-to-many tradicionales
                {
                    "relationship_type": "one_to_many",
                    "from_table": "categorias",
                    "from_field": "id",
                    "to_table": "productos",
                    "to_field": "categoria_id",
                    "relationship_name": "productos",
                    "back_populates": "categoria"
                },
                {
                    "relationship_type": "one_to_many",
                    "from_table": "usuarios",
                    "from_field": "id",
                    "to_table": "pedidos",
                    "to_field": "usuario_id",
                    "relationship_name": "pedidos",
                    "back_populates": "usuario"
                },
                {
                    "relationship_type": "one_to_many",
                    "from_table": "pedidos",
                    "from_field": "id",
                    "to_table": "detalle_pedidos",
                    "to_field": "pedido_id",
                    "relationship_name": "detalles",
                    "back_populates": "pedido"
                },
                {
                    "relationship_type": "one_to_many",
                    "from_table": "productos",
                    "from_field": "id",
                    "to_table": "detalle_pedidos",
                    "to_field": "producto_id",
                    "relationship_name": "detalles_pedido",
                    "back_populates": "producto"
                },
                # Relaciones many-to-many (NOVEDAD FASE 2)
                {
                    "relationship_type": "many_to_many",
                    "from_table": "productos",
                    "from_field": "id",
                    "to_table": "etiquetas",
                    "to_field": "id",
                    "relationship_name": "etiquetas",
                    "back_populates": "productos",
                    "junction_table": "productos_etiquetas"
                }
            ]
        }
    
    @staticmethod
    def social_network_system() -> Dict[str, Any]:
        """
        Sistema de red social con múltiples relaciones many-to-many
        """
        return {
            "service_name": "social_network",
            "description": "Plataforma de red social con usuarios, posts, seguidores y grupos",
            "version": "2.0.0",
            "generate_many_to_many": True,
            "generate_complex_queries": True,
            "generate_aggregation_endpoints": True,
            "tables": [
                {
                    "name": "usuarios",
                    "description": "Perfiles de usuarios",
                    "enable_soft_delete": True,
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "username", "field_type": "string", "max_length": 50, "unique": True, "nullable": False},
                        {"name": "email", "field_type": "email", "unique": True, "nullable": False},
                        {"name": "nombre_completo", "field_type": "string", "max_length": 150},
                        {"name": "bio", "field_type": "text"},
                        {"name": "avatar_url", "field_type": "url"},
                        {"name": "fecha_registro", "field_type": "datetime", "default_value": "now()"},
                        {"name": "ultimo_acceso", "field_type": "datetime"},
                        {"name": "verificado", "field_type": "boolean", "default_value": "false"},
                        {"name": "privado", "field_type": "boolean", "default_value": "false"}
                    ]
                },
                {
                    "name": "posts",
                    "description": "Publicaciones de usuarios",
                    "enable_versioning": True,
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "usuario_id", "field_type": "integer", "foreign_key": "usuarios.id", "nullable": False},
                        {"name": "contenido", "field_type": "text", "nullable": False},
                        {"name": "imagen_url", "field_type": "url"},
                        {"name": "fecha_publicacion", "field_type": "datetime", "default_value": "now()"},
                        {"name": "editado", "field_type": "boolean", "default_value": "false"},
                        {"name": "publico", "field_type": "boolean", "default_value": "true"},
                        {"name": "num_likes", "field_type": "integer", "default_value": "0"},
                        {"name": "num_comentarios", "field_type": "integer", "default_value": "0"}
                    ]
                },
                {
                    "name": "comentarios",
                    "description": "Comentarios en posts",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "post_id", "field_type": "integer", "foreign_key": "posts.id", "nullable": False},
                        {"name": "usuario_id", "field_type": "integer", "foreign_key": "usuarios.id", "nullable": False},
                        {"name": "contenido", "field_type": "text", "nullable": False},
                        {"name": "fecha_comentario", "field_type": "datetime", "default_value": "now()"},
                        {"name": "editado", "field_type": "boolean", "default_value": "false"}
                    ]
                },
                {
                    "name": "grupos",
                    "description": "Grupos y comunidades",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "descripcion", "field_type": "text"},
                        {"name": "imagen_url", "field_type": "url"},
                        {"name": "publico", "field_type": "boolean", "default_value": "true"},
                        {"name": "fecha_creacion", "field_type": "datetime", "default_value": "now()"},
                        {"name": "creador_id", "field_type": "integer", "foreign_key": "usuarios.id"},
                        {"name": "num_miembros", "field_type": "integer", "default_value": "0"}
                    ]
                }
            ],
            "relationships": [
                # Relaciones tradicionales
                {
                    "relationship_type": "one_to_many",
                    "from_table": "usuarios",
                    "from_field": "id",
                    "to_table": "posts",
                    "to_field": "usuario_id",
                    "relationship_name": "posts",
                    "back_populates": "autor"
                },
                {
                    "relationship_type": "one_to_many",
                    "from_table": "posts",
                    "from_field": "id",
                    "to_table": "comentarios",
                    "to_field": "post_id",
                    "relationship_name": "comentarios",
                    "back_populates": "post"
                },
                # Relaciones many-to-many complejas
                {
                    "relationship_type": "many_to_many",
                    "from_table": "usuarios",
                    "from_field": "id",
                    "to_table": "usuarios",
                    "to_field": "id",
                    "relationship_name": "seguidores",
                    "back_populates": "siguiendo",
                    "junction_table": "seguidores"
                },
                {
                    "relationship_type": "many_to_many",
                    "from_table": "usuarios",
                    "from_field": "id",
                    "to_table": "posts",
                    "to_field": "id",
                    "relationship_name": "posts_liked",
                    "back_populates": "usuarios_like",
                    "junction_table": "likes"
                },
                {
                    "relationship_type": "many_to_many",
                    "from_table": "usuarios",
                    "from_field": "id",
                    "to_table": "grupos",
                    "to_field": "id",
                    "relationship_name": "grupos",
                    "back_populates": "miembros",
                    "junction_table": "miembros_grupos"
                }
            ]
        }
    
    @staticmethod
    def learning_management_system() -> Dict[str, Any]:
        """
        Sistema de gestión de aprendizaje (LMS)
        """
        return {
            "service_name": "lms_system",
            "description": "Sistema de gestión de aprendizaje con cursos, estudiantes y evaluaciones",
            "version": "2.0.0",
            "generate_many_to_many": True,
            "generate_complex_queries": True,
            "tables": [
                {
                    "name": "profesores",
                    "description": "Profesores del sistema",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "email", "field_type": "email", "unique": True, "nullable": False},
                        {"name": "especialidad", "field_type": "string", "max_length": 100},
                        {"name": "biografia", "field_type": "text"},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "estudiantes",
                    "description": "Estudiantes del sistema",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "email", "field_type": "email", "unique": True, "nullable": False},
                        {"name": "matricula", "field_type": "string", "max_length": 20, "unique": True},
                        {"name": "fecha_ingreso", "field_type": "date"},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "cursos",
                    "description": "Cursos disponibles",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 200, "nullable": False},
                        {"name": "descripcion", "field_type": "text"},
                        {"name": "codigo", "field_type": "string", "max_length": 20, "unique": True},
                        {"name": "creditos", "field_type": "integer", "default_value": "3"},
                        {"name": "duracion_semanas", "field_type": "integer"},
                        {"name": "precio", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "materias",
                    "description": "Materias de los cursos",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 150, "nullable": False},
                        {"name": "descripcion", "field_type": "text"},
                        {"name": "orden", "field_type": "integer", "default_value": "1"}
                    ]
                }
            ],
            "relationships": [
                # Many-to-many: profesores pueden enseñar múltiples cursos
                {
                    "relationship_type": "many_to_many",
                    "from_table": "profesores",
                    "from_field": "id",
                    "to_table": "cursos",
                    "to_field": "id",
                    "relationship_name": "cursos",
                    "back_populates": "profesores",
                    "junction_table": "profesores_cursos"
                },
                # Many-to-many: estudiantes pueden inscribirse en múltiples cursos
                {
                    "relationship_type": "many_to_many",
                    "from_table": "estudiantes",
                    "from_field": "id",
                    "to_table": "cursos",
                    "to_field": "id",
                    "relationship_name": "cursos_inscritos",
                    "back_populates": "estudiantes",
                    "junction_table": "inscripciones"
                },
                # Many-to-many: cursos tienen múltiples materias
                {
                    "relationship_type": "many_to_many",
                    "from_table": "cursos",
                    "from_field": "id",
                    "to_table": "materias",
                    "to_field": "id",
                    "relationship_name": "materias",
                    "back_populates": "cursos",
                    "junction_table": "cursos_materias"
                }
            ]
        }
    
    @staticmethod
    def inventory_management_system() -> Dict[str, Any]:
        """
        Sistema avanzado de gestión de inventario
        """
        return {
            "service_name": "inventory_system",
            "description": "Sistema avanzado de gestión de inventario multi-almacén",
            "version": "2.0.0",
            "generate_many_to_many": True,
            "generate_complex_queries": True,
            "tables": [
                {
                    "name": "almacenes",
                    "description": "Almacenes y ubicaciones",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 100, "nullable": False},
                        {"name": "direccion", "field_type": "text"},
                        {"name": "ciudad", "field_type": "string", "max_length": 100},
                        {"name": "pais", "field_type": "string", "max_length": 100},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "proveedores",
                    "description": "Proveedores de productos",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 150, "nullable": False},
                        {"name": "email", "field_type": "email"},
                        {"name": "telefono", "field_type": "phone"},
                        {"name": "direccion", "field_type": "text"},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "productos",
                    "description": "Productos del inventario",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "nombre", "field_type": "string", "max_length": 200, "nullable": False},
                        {"name": "descripcion", "field_type": "text"},
                        {"name": "sku", "field_type": "string", "max_length": 50, "unique": True},
                        {"name": "precio_compra", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "precio_venta", "field_type": "decimal", "precision": 10, "scale": 2},
                        {"name": "stock_minimo", "field_type": "integer", "default_value": "0"},
                        {"name": "activo", "field_type": "boolean", "default_value": "true"}
                    ]
                },
                {
                    "name": "movimientos",
                    "description": "Movimientos de inventario",
                    "fields": [
                        {"name": "id", "field_type": "integer", "primary_key": True, "auto_increment": True},
                        {"name": "producto_id", "field_type": "integer", "foreign_key": "productos.id", "nullable": False},
                        {"name": "almacen_id", "field_type": "integer", "foreign_key": "almacenes.id", "nullable": False},
                        {"name": "tipo_movimiento", "field_type": "enum", "enum_values": ["entrada", "salida", "transferencia", "ajuste"]},
                        {"name": "cantidad", "field_type": "integer", "nullable": False},
                        {"name": "fecha_movimiento", "field_type": "datetime", "default_value": "now()"},
                        {"name": "observaciones", "field_type": "text"}
                    ]
                }
            ],
            "relationships": [
                # Relaciones tradicionales
                {
                    "relationship_type": "one_to_many",
                    "from_table": "productos",
                    "from_field": "id",
                    "to_table": "movimientos",
                    "to_field": "producto_id",
                    "relationship_name": "movimientos",
                    "back_populates": "producto"
                },
                {
                    "relationship_type": "one_to_many",
                    "from_table": "almacenes",
                    "from_field": "id",
                    "to_table": "movimientos",
                    "to_field": "almacen_id",
                    "relationship_name": "movimientos",
                    "back_populates": "almacen"
                },
                # Many-to-many: productos pueden tener múltiples proveedores
                {
                    "relationship_type": "many_to_many",
                    "from_table": "productos",
                    "from_field": "id",
                    "to_table": "proveedores",
                    "to_field": "id",
                    "relationship_name": "proveedores",
                    "back_populates": "productos",
                    "junction_table": "productos_proveedores"
                }
            ]
        }
    
    @staticmethod
    def get_all_templates() -> Dict[str, Dict[str, Any]]:
        """Obtiene todos los templates disponibles"""
        return {
            "ecommerce": Phase2Templates.ecommerce_system(),
            "social_network": Phase2Templates.social_network_system(),
            "lms": Phase2Templates.learning_management_system(),
            "inventory": Phase2Templates.inventory_management_system()
        }
    
    @staticmethod
    def get_template_info() -> Dict[str, str]:
        """Información sobre los templates disponibles"""
        return {
            "ecommerce": "Sistema completo de e-commerce con productos, pedidos, usuarios y relaciones many-to-many",
            "social_network": "Plataforma de red social con usuarios, posts, seguidores y grupos (relaciones complejas)",
            "lms": "Sistema de gestión de aprendizaje con profesores, estudiantes, cursos y materias",
            "inventory": "Sistema avanzado de gestión de inventario multi-almacén con proveedores"
        }
