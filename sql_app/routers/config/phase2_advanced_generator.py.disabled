# ============================================================================
# FASE_2_ADVANCED_GENERATOR.PY - GENERADOR AVANZADO MULTI-TABLA (FASE 2)
# ============================================================================
"""
Generador avanzado para sistemas multi-tabla con funcionalidades de Fase 2:
- Relaciones Many-to-Many automáticas
- Tablas de unión
- Queries complejas con múltiples JOINs
- Soporte para N tablas (sin límites)
- Templates predefinidos
"""

import os
import asyncio
from typing import Dict, List, Optional, Tuple, Any
from dataclasses import dataclass
from pathlib import Path
import logging

from sql_app.routers.config.generator_config import (
    MultiTableServiceConfig, TableConfig, FieldConfig, RelationshipConfig,
    GENERATOR_CONFIG
)

# Configurar logger simple
logger = logging.getLogger(__name__)

@dataclass
class JunctionTableConfig:
    """Configuración para tablas de unión (many-to-many)"""
    name: str
    from_table: str
    to_table: str
    from_field: str
    to_field: str
    additional_fields: List[FieldConfig] = None
    
    def __post_init__(self):
        if self.additional_fields is None:
            self.additional_fields = []

class Phase2AdvancedGenerator:
    """Generador avanzado para Fase 2 con funcionalidades extendidas"""
    
    def __init__(self):
        self.junction_tables: List[JunctionTableConfig] = []
        self.complex_queries: Dict[str, str] = {}
        self.generated_files: List[str] = []
    
    async def generate_complete_system(self, config: MultiTableServiceConfig) -> Dict:
        """
        Genera un sistema completo multi-tabla con todas las funcionalidades de Fase 2
        """
        logger.info(f"🚀 INICIO - Generación sistema avanzado Fase 2 '{config.service_name}'")
        
        try:
            results = {
                "success": True,
                "generated_files": [],
                "junction_tables": [],
                "complex_queries": [],
                "statistics": {},
                "phase": "2"
            }
            
            # 1. Generar tablas de unión para many-to-many
            if config.generate_many_to_many:
                junction_results = await self._generate_junction_tables(config)
                results["junction_tables"] = junction_results
                results["generated_files"].extend(junction_results)
            
            # 2. Generar modelos extendidos con relaciones many-to-many
            models_result = await self._generate_advanced_models(config)
            results["generated_files"].extend(models_result)
            
            # 3. Generar CRUDs avanzados con operaciones many-to-many
            crud_result = await self._generate_advanced_cruds(config)
            results["generated_files"].extend(crud_result)
            
            # 4. Generar queries complejas con múltiples JOINs
            if config.generate_complex_queries:
                queries_result = await self._generate_complex_queries(config)
                results["complex_queries"] = queries_result
                results["generated_files"].extend(queries_result)
            
            # 5. Generar endpoints de agregación
            if config.generate_aggregation_endpoints:
                aggregation_result = await self._generate_aggregation_endpoints(config)
                results["generated_files"].extend(aggregation_result)
            
            # 6. Generar documentación OpenAPI extendida
            if config.generate_openapi_docs:
                docs_result = await self._generate_openapi_docs(config)
                results["generated_files"].extend(docs_result)
            
            # 7. Calcular estadísticas
            results["statistics"] = self._calculate_system_statistics(config)
            
            logger.info(f"✅ ÉXITO - Sistema Fase 2 generado: {len(results['generated_files'])} archivos")
            return results
            
        except Exception as e:
            logger.error(f"❌ ERROR - Generación Fase 2 falló: {str(e)}")
            return {
                "success": False,
                "error": str(e),
                "generated_files": [],
                "phase": "2"
            }
    
    async def _generate_junction_tables(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera tablas de unión para relaciones many-to-many"""
        logger.info("🔗 Generando tablas de unión many-to-many")
        
        junction_files = []
        m2m_relationships = config.get_many_to_many_relationships()
        
        for rel in m2m_relationships:
            junction_config = JunctionTableConfig(
                name=rel.junction_table,
                from_table=rel.from_table,
                to_table=rel.to_table,
                from_field=rel.from_field,
                to_field=rel.to_field
            )
            
            junction_file = await self._create_junction_table_file(junction_config)
            junction_files.append(junction_file)
            self.junction_tables.append(junction_config)
            
            logger.info(f"✅ Tabla de unión creada: {junction_config.name}")
        
        return junction_files
    
    async def _create_junction_table_file(self, junction: JunctionTableConfig) -> str:
        """Crea archivo de tabla de unión"""
        content = f'''# ============================================================================
# TABLA DE UNIÓN: {junction.name.upper()}
# ============================================================================
"""
Tabla de unión generada automáticamente para relación many-to-many
Entre: {junction.from_table} <-> {junction.to_table}
"""

from sqlalchemy import Column, Integer, ForeignKey, DateTime, Boolean
from sqlalchemy.orm import relationship
from sql_app.db.database import Base
from datetime import datetime

class {junction.name.title().replace('_', '')}(Base):
    """
    Tabla de unión para relación many-to-many
    {junction.from_table} <-> {junction.to_table}
    """
    __tablename__ = "{junction.name}"
    
    id = Column(Integer, primary_key=True, autoincrement=True)
    {junction.from_table}_id = Column(Integer, ForeignKey("{junction.from_table}.{junction.from_field}"), nullable=False)
    {junction.to_table}_id = Column(Integer, ForeignKey("{junction.to_table}.{junction.to_field}"), nullable=False)
    
    # Metadatos adicionales
    created_at = Column(DateTime, default=datetime.utcnow)
    is_active = Column(Boolean, default=True)
    
    # Relaciones
    {junction.from_table} = relationship("{junction.from_table.title()}", back_populates="{junction.to_table}_rel")
    {junction.to_table} = relationship("{junction.to_table.title()}", back_populates="{junction.from_table}_rel")
    
    def __repr__(self):
        return f"<{junction.name.title().replace('_', '')}({junction.from_table}_id={{self.{junction.from_table}_id}}, {junction.to_table}_id={{self.{junction.to_table}_id}})>"
'''
        
        # Crear archivo
        service_dir = Path(GENERATOR_CONFIG.paths.services) / f"{junction.from_table}_{junction.to_table}_service"
        service_dir.mkdir(parents=True, exist_ok=True)
        
        file_path = service_dir / f"{junction.name}_model.py"
        
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content)
        
        return str(file_path)
    
    async def _generate_advanced_models(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera modelos avanzados con soporte many-to-many"""
        logger.info("🏗️ Generando modelos avanzados con many-to-many")
        
        content = self._create_advanced_models_content(config)
        
        service_dir = Path(GENERATOR_CONFIG.paths.services) / config.service_name
        service_dir.mkdir(parents=True, exist_ok=True)
        
        file_path = service_dir / f"{config.service_name}_advanced_models.py"
        
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content)
        
        logger.info(f"✅ Modelos avanzados generados: {file_path}")
        return [str(file_path)]
    
    def _create_advanced_models_content(self, config: MultiTableServiceConfig) -> str:
        """Crea contenido de modelos avanzados"""
        content = f'''# ============================================================================
# MODELOS AVANZADOS FASE 2: {config.service_name.upper()}
# ============================================================================
"""
{config.description}

Sistema multi-tabla avanzado con funcionalidades Fase 2:
- Relaciones Many-to-Many automáticas
- Tablas de unión generadas
- Soporte para N tablas: {len(config.tables)}
- Relaciones totales: {len(config.relationships)}

Generado automáticamente - Fase 2
Versión: {config.version}
"""

from sqlalchemy import Column, Integer, String, Float, Boolean, DateTime, Text, ForeignKey, Table
from sqlalchemy.orm import relationship
from sql_app.db.database import Base
from datetime import datetime

'''
        
        # Generar tablas de asociación para many-to-many
        m2m_relationships = config.get_many_to_many_relationships()
        for rel in m2m_relationships:
            content += f'''
# Tabla de asociación para {rel.from_table} <-> {rel.to_table}
{rel.junction_table}_table = Table(
    '{rel.junction_table}',
    Base.metadata,
    Column('{rel.from_table}_id', Integer, ForeignKey('{rel.from_table}.{rel.from_field}')),
    Column('{rel.to_table}_id', Integer, ForeignKey('{rel.to_table}.{rel.to_field}')),
    Column('created_at', DateTime, default=datetime.utcnow),
    Column('is_active', Boolean, default=True)
)
'''
        
        # Generar modelos para cada tabla
        for table in config.tables:
            content += f'''

class {table.get_model_name()}(Base):
    """
    Modelo avanzado para {table.name}
    {table.description or f'Tabla {table.name}'}
    
    Configuración Fase 2:
    - Campos: {len(table.fields)}
    - Búsqueda habilitada: {table.search_fields or "Automática"}
    - Acceso público: {table.is_public}
    - Requiere autenticación: {table.requires_auth}
    """
    __tablename__ = "{table.name}"
    
    # Configuración de tabla
    __table_args__ = {{
        'mysql_engine': '{table.table_engine}',
        'mysql_charset': '{table.table_charset}',
        'mysql_collate': '{table.table_collation}'
    }}
'''
            
            # Generar campos
            for field in table.fields:
                content += f"    {field.name} = {field.get_column_definition()}"
                if field.description:
                    content += f"  # {field.description}"
                content += "\n"
            
            # Generar relaciones many-to-many
            table_m2m_rels = [rel for rel in m2m_relationships 
                             if rel.from_table == table.name or rel.to_table == table.name]
            
            if table_m2m_rels:
                content += "\n    # Relaciones Many-to-Many\n"
                for rel in table_m2m_rels:
                    if rel.from_table == table.name:
                        target_table = rel.to_table
                        target_model = config.get_table_by_name(target_table).get_model_name()
                        content += f'    {rel.relationship_name} = relationship("{target_model}", secondary={rel.junction_table}_table, back_populates="{rel.back_populates}")\n'
            
            # Generar relaciones one-to-many y many-to-one
            table_rels = [rel for rel in config.relationships 
                         if rel.from_table == table.name and rel.relationship_type != "many_to_many"]
            
            if table_rels:
                content += "\n    # Relaciones One-to-Many / Many-to-One\n"
                for rel in table_rels:
                    target_model = config.get_table_by_name(rel.to_table).get_model_name()
                    if rel.order_by:
                        content += f'    {rel.relationship_name} = relationship("{target_model}", back_populates="{rel.back_populates}", order_by="{rel.order_by}")\n'
                    else:
                        content += f'    {rel.relationship_name} = relationship("{target_model}", back_populates="{rel.back_populates}")\n'
            
            # Métodos adicionales para Fase 2
            content += f'''
    def __repr__(self):
        return f"<{table.get_model_name()}(id={{self.{table.get_primary_key_field().name if table.get_primary_key_field() else 'id'}}})>"
    
    def to_dict_basic(self):
        """Conversión básica a diccionario"""
        return {{column.name: getattr(self, column.name) for column in self.__table__.columns}}
    
    def to_dict_with_relations(self):
        """Conversión a diccionario incluyendo relaciones"""
        result = self.to_dict_basic()
        # Agregar relaciones many-to-many
'''
            
            for rel in table_m2m_rels:
                if rel.from_table == table.name:
                    content += f'        if hasattr(self, "{rel.relationship_name}"):\n'
                    content += f'            result["{rel.relationship_name}"] = [item.to_dict_basic() for item in getattr(self, "{rel.relationship_name}")]\n'
            
            content += "        return result\n"
        
        return content
    
    async def _generate_advanced_cruds(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera CRUDs avanzados con operaciones many-to-many"""
        logger.info("🔧 Generando CRUDs avanzados")
        
        generated_files = []
        
        for table in config.tables:
            crud_content = self._create_advanced_crud_content(table, config)
            
            service_dir = Path(GENERATOR_CONFIG.paths.services) / config.service_name / "advanced_crud"
            service_dir.mkdir(parents=True, exist_ok=True)
            
            file_path = service_dir / f"{table.name}_advanced_crud.py"
            
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(crud_content)
            
            generated_files.append(str(file_path))
            logger.info(f"✅ CRUD avanzado generado: {table.name}")
        
        return generated_files
    
    def _create_advanced_crud_content(self, table: TableConfig, config: MultiTableServiceConfig) -> str:
        """Crea contenido de CRUD avanzado"""
        model_name = table.get_model_name()
        
        return f'''# ============================================================================
# CRUD AVANZADO FASE 2: {table.name.upper()}
# ============================================================================
"""
CRUD avanzado para {table.name} con funcionalidades Fase 2:
- Operaciones many-to-many
- Búsquedas complejas
- Filtros avanzados
- Paginación optimizada
- Agregaciones
"""

from typing import List, Optional, Dict, Any
from sqlalchemy.orm import Session, joinedload, selectinload
from sqlalchemy import and_, or_, func, desc, asc
from fastapi import HTTPException, status

from sql_app.db.database import get_db
from sql_app.Services.{config.service_name}.{config.service_name}_advanced_models import {model_name}

class {model_name}AdvancedCRUD:
    """CRUD avanzado para {table.name} con funcionalidades Fase 2"""
    
    def __init__(self, db: Session):
        self.db = db
        self.model = {model_name}
    
    async def create_with_relations(self, data: Dict[str, Any]) -> {model_name}:
        """
        Crear registro con relaciones many-to-many
        """
        # Separar datos del modelo y relaciones
        model_data = {{k: v for k, v in data.items() if not k.endswith('_ids')}}
        relation_data = {{k: v for k, v in data.items() if k.endswith('_ids')}}
        
        # Crear registro principal
        db_obj = self.model(**model_data)
        self.db.add(db_obj)
        self.db.commit()
        self.db.refresh(db_obj)
        
        # Agregar relaciones many-to-many
        for relation_field, ids in relation_data.items():
            if ids:
                await self._add_many_to_many_relations(db_obj, relation_field, ids)
        
        return db_obj
    
    async def get_with_relations(self, id: int) -> Optional[{model_name}]:
        """
        Obtener registro con todas las relaciones cargadas
        """
        return self.db.query(self.model).options(
            selectinload('*')  # Cargar todas las relaciones
        ).filter(self.model.id == id).first()
    
    async def search_advanced(self, 
                            search_term: Optional[str] = None,
                            filters: Dict[str, Any] = None,
                            sort_by: Optional[str] = None,
                            sort_desc: bool = False,
                            page: int = 1,
                            page_size: int = 20) -> Dict[str, Any]:
        """
        Búsqueda avanzada con filtros, ordenamiento y paginación
        """
        query = self.db.query(self.model)
        
        # Aplicar búsqueda por texto
        if search_term:
            search_conditions = []'''
        
        # Agregar campos de búsqueda
        searchable_fields = table.get_searchable_fields()
        for field in searchable_fields:
            if field.field_type in ['string', 'text']:
                return f'''            search_conditions.append(self.model.{field.name}.ilike(f"%{{search_term}}%"))
'''
        
        return f'''        
            if search_conditions:
                query = query.filter(or_(*search_conditions))
        
        # Aplicar filtros
        if filters:
            for field, value in filters.items():
                if hasattr(self.model, field) and value is not None:
                    query = query.filter(getattr(self.model, field) == value)
        
        # Aplicar ordenamiento
        if sort_by and hasattr(self.model, sort_by):
            order_func = desc if sort_desc else asc
            query = query.order_by(order_func(getattr(self.model, sort_by)))
        
        # Contar total
        total = query.count()
        
        # Aplicar paginación
        offset = (page - 1) * page_size
        items = query.offset(offset).limit(page_size).all()
        
        return {{
            "items": items,
            "total": total,
            "page": page,
            "page_size": page_size,
            "total_pages": (total + page_size - 1) // page_size
        }}
    
    async def get_aggregations(self) -> Dict[str, Any]:
        """
        Obtener agregaciones y estadísticas
        """
        return {{
            "total_count": self.db.query(func.count(self.model.id)).scalar(),
            "created_today": self.db.query(func.count(self.model.id)).filter(
                func.date(self.model.created_at) == func.current_date()
            ).scalar() if hasattr(self.model, 'created_at') else 0
        }}
    
    async def _add_many_to_many_relations(self, obj: {model_name}, relation_field: str, ids: List[int]):
        """Agregar relaciones many-to-many"""
        # Implementación específica según las relaciones definidas
        pass
'''
    
    async def _generate_complex_queries(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera queries complejas con múltiples JOINs"""
        logger.info("🔍 Generando queries complejas")
        
        content = f'''# ============================================================================
# QUERIES COMPLEJAS FASE 2: {config.service_name.upper()}
# ============================================================================
"""
Queries complejas con múltiples JOINs para {config.service_name}
Generadas automáticamente - Fase 2
"""

from typing import List, Dict, Any, Optional
from sqlalchemy.orm import Session
from sqlalchemy import func, and_, or_, text
from fastapi import Query

class ComplexQueries:
    """Queries complejas para el sistema multi-tabla"""
    
    def __init__(self, db: Session):
        self.db = db
'''
        
        # Generar queries basadas en las relaciones
        for i, table in enumerate(config.tables):
            content += f'''
    
    async def get_{table.name}_with_all_relations(self, id: int) -> Dict[str, Any]:
        """
        Obtener {table.name} con todas sus relaciones en una sola query
        """
        # Query compleja con múltiples JOINs
        query = """
        SELECT 
            main.*,
            -- Agregar campos de tablas relacionadas aquí
        FROM {table.name} main
        """
        
        result = self.db.execute(text(query), {{"id": id}})
        return result.fetchone()._asdict() if result else None
'''
        
        service_dir = Path(GENERATOR_CONFIG.paths.services) / config.service_name
        service_dir.mkdir(parents=True, exist_ok=True)
        
        file_path = service_dir / "complex_queries.py"
        
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content)
        
        logger.info(f"✅ Queries complejas generadas: {file_path}")
        return [str(file_path)]
    
    async def _generate_aggregation_endpoints(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera endpoints de agregación"""
        logger.info("📊 Generando endpoints de agregación")
        
        content = f'''# ============================================================================
# ENDPOINTS DE AGREGACIÓN FASE 2: {config.service_name.upper()}
# ============================================================================
"""
Endpoints de agregación y estadísticas para {config.service_name}
"""

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from typing import Dict, Any

from sql_app.db.database import get_db

router = APIRouter(prefix="/{config.service_name}/aggregations", tags=["Agregaciones"])

@router.get("/dashboard-stats")
async def get_dashboard_stats(db: Session = Depends(get_db)) -> Dict[str, Any]:
    """
    Estadísticas generales para dashboard
    """
    stats = {{}}
'''
        
        for table in config.tables:
            content += f'''    
    # Estadísticas para {table.name}
    stats["{table.name}"] = {{
        "total": db.query(func.count({table.get_model_name()}.id)).scalar(),
        "recent": db.query(func.count({table.get_model_name()}.id)).filter(
            {table.get_model_name()}.created_at >= func.now() - text('INTERVAL 7 DAY')
        ).scalar() if hasattr({table.get_model_name()}, 'created_at') else 0
    }}
'''
        
        content += '''
    return stats
'''
        
        service_dir = Path(GENERATOR_CONFIG.paths.services) / config.service_name
        service_dir.mkdir(parents=True, exist_ok=True)
        
        file_path = service_dir / "aggregation_endpoints.py"
        
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content)
        
        logger.info(f"✅ Endpoints de agregación generados: {file_path}")
        return [str(file_path)]
    
    async def _generate_openapi_docs(self, config: MultiTableServiceConfig) -> List[str]:
        """Genera documentación OpenAPI extendida"""
        logger.info("📚 Generando documentación OpenAPI extendida")
        
        content = f'''# ============================================================================
# DOCUMENTACIÓN OPENAPI FASE 2: {config.service_name.upper()}
# ============================================================================
"""
Documentación OpenAPI extendida para {config.service_name}
"""

from fastapi import FastAPI
from typing import Dict, Any

def enhance_openapi_schema(app: FastAPI) -> Dict[str, Any]:
    """
    Mejora el esquema OpenAPI con información de Fase 2
    """
    if app.openapi_schema:
        return app.openapi_schema
    
    openapi_schema = {{
        "openapi": "3.0.2",
        "info": {{
            "title": "{config.service_name.title()} API",
            "version": "{config.version}",
            "description": "{config.description}",
            "license": {{
                "name": "{config.license}",
                "url": "https://opensource.org/licenses/MIT"
            }}
        }},
        "servers": [
            {{
                "url": "{config.api_prefix}",
                "description": "API Server"
            }}
        ],
        "tags": [
'''
        
        for table in config.tables:
            content += f'''            {{
                "name": "{table.name.title()}",
                "description": "{table.description or f'Operaciones para {table.name}'}"
            }},
'''
        
        content += '''        ]
    }
    
    app.openapi_schema = openapi_schema
    return app.openapi_schema
'''
        
        service_dir = Path(GENERATOR_CONFIG.paths.services) / config.service_name
        file_path = service_dir / "openapi_docs.py"
        
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(content)
        
        logger.info(f"✅ Documentación OpenAPI generada: {file_path}")
        return [str(file_path)]
    
    def _calculate_system_statistics(self, config: MultiTableServiceConfig) -> Dict[str, Any]:
        """Calcula estadísticas del sistema generado"""
        return {
            "phase": "2",
            "tables_count": len(config.tables),
            "total_fields": sum(len(table.fields) for table in config.tables),
            "relationships_count": len(config.relationships),
            "many_to_many_count": len(config.get_many_to_many_relationships()),
            "junction_tables_count": len(config.get_junction_tables_needed()),
            "complexity_score": config.estimate_complexity()["complexity_score"],
            "estimated_endpoints": len(config.tables) * 5 + len(config.relationships) * 2,
            "features_enabled": {
                "many_to_many": config.generate_many_to_many,
                "complex_queries": config.generate_complex_queries,
                "aggregations": config.generate_aggregation_endpoints,
                "openapi_docs": config.generate_openapi_docs
            }
        }

# Factory para crear el generador
def create_phase2_generator() -> Phase2AdvancedGenerator:
    """Factory para crear generador de Fase 2"""
    return Phase2AdvancedGenerator()
